{
  "appId": "cc.xeghep.www.ios",
  "appName": "XeGhep.CC",
  "webDir": "dist",
  "bundleWebRuntime": false,
  "backgroundColor": "#F2F2F7",
  "plugins": {
    "BackgroundGeolocation": {
      "backgroundMessage": "Đang cập nhật vị trí hành trình...",
      "backgroundTitle": "XeGhep.CC đang chạy ngầm"
    },
    "SplashScreen": {
      "launchShowDuration": 2000,
      "launchAutoHide": true,
      "backgroundColor": "#F2F2F7",
      "showSpinner": false,
      "androidScaleType": "CENTER_CROP",
      "androidSplashResourceName": "splash",
      "iosScaleType": "aspectFit",
      "splashFullScreen": false,
      "splashImmersive": false
    },
    "FirebaseMessaging": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  },
  "ios": {
    "contentInset": "always",
    "allowsLinkPreview": false
  }
}
