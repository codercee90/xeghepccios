<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleDisplayName</key>
    <string>XeGhep.CC</string>
    <key>CFBundleExecutable</key>
    <string>$(EXECUTABLE_NAME)</string>
    <key>CFBundleIdentifier</key>
    <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
    <key>CFBundleInfoDictionaryVersion</key>
    <string>6.0</string>
    <key>CFBundleName</key>
    <string>$(PRODUCT_NAME)</string>
    <key>CFBundlePackageType</key>
    <string>APPL</string>
    <key>CFBundleShortVersionString</key>
    <string>1.0.0</string>
    <key>CFBundleVersion</key>
    <string>1</string>
    <key>LSRequiresIPhoneOS</key>
    <true/>

    <!-- Khởi tạo quyền vị trí chạy ngầm và Push Notification -->
    <key>UIBackgroundModes</key>
    <array>
        <string>location</string>
        <string>remote-notification</string>
    </array>

    <!-- Quyền Camera, Micro, Thư viện ảnh -->
    <key>NSCameraUsageDescription</key>
    <string>Ứng dụng cần truy cập Camera để chụp ảnh đại diện và gửi hình ảnh chuyến đi.</string>
    <key>NSMicrophoneUsageDescription</key>
    <string>Ứng dụng cần truy cập Micro để thực hiện cuộc gọi hoặc ghi âm tin nhắn.</string>
    <key>NSPhotoLibraryUsageDescription</key>
    <string>Ứng dụng cần truy cập Thư viện ảnh để chọn hình ảnh gửi trong ứng dụng.</string>
    <key>NSPhotoLibraryAddUsageDescription</key>
    <string>Ứng dụng cần quyền lưu ảnh vào Thư viện của bạn.</string>

    <!-- Quyền Vị trí (Foreground & Background) -->
    <key>NSLocationWhenInUseUsageDescription</key>
    <string>Ứng dụng cần vị trí của bạn để tìm chuyến xe gần nhất.</string>
    <key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
    <string>Ứng dụng cần vị trí chạy ngầm để cập nhật định vị lộ trình di chuyển liên tục.</string>
    <key>NSLocationAlwaysUsageDescription</key>
    <string>Ứng dụng cần truy cập vị trí chạy ngầm để đảm bảo an toàn cho chuyến đi.</string>

    <!-- Cho phép mở app ngoài: Zalo, Google Maps -->
    <key>LSApplicationQueriesSchemes</key>
    <array>
        <string>zalo</string>
        <string>comgooglemaps</string>
        <string>googlemaps</string>
    </array>
</dict>
</plist>